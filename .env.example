# ===== LLM 配置 =====
# 默认提供商: deepseek | openai | ollama | gemini
# - deepseek: 云端，需要 API Key，质量最佳
# - openai:   云端，需要 API Key，支持图片分析
# - gemini:   云端免费，支持图片分析 (1500次/天)
# - ollama:   本地，完全免费离线，隐私安全 (推荐分享给他人时使用)
LLM_PROVIDER=deepseek

# DeepSeek API (云端，推荐)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API (云端备选)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Google Gemini API (免费额度: 1500次/天, 支持图片分析!)
# 获取 Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Ollama 本地模型 (免费，无需 API Key)
# 安装: https://ollama.com  →  下载模型: ollama pull qwen3:14b
# 切换到此模式: LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:14b

# ===== 嵌入模型 =====
# 本地模型 (默认，离线可用)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# 中文增强模型 (可选，需要额外下载)
# EMBEDDING_MODEL=BAAI/bge-m3

# ===== 昆明理工大学图书馆 (可选) =====
# 仅提供接口，用户自行配置合法凭证
KUST_LIBRARY_PROXY_URL=
CNKI_USERNAME=
CNKI_PASSWORD=
WANFANG_USERNAME=
WANFANG_PASSWORD=

# ===== 可选 API Keys =====
SEMANTIC_SCHOLAR_API_KEY=
TAVILY_API_KEY=
